# Keep identity-pinned generation-3 text byte-stable on every checkout.
/.gitattributes text eol=lf
/.gitignore text eol=lf
/tools/omega_nnue/** text=auto eol=lf
/validation/omega-nnue-king-state-v3-*.json text eol=lf

# The frozen runtime is an opaque byte archive, including text sidecars.
/tools/omega_nnue/frozen_runtime/king-state-v3/** -text -diff !eol
