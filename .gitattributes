# Keep identity-pinned generation-3 text byte-stable on every checkout.
/.gitattributes text eol=lf
/.gitignore text eol=lf
/tools/omega_nnue/** text=auto eol=lf
/validation/omega-nnue-king-state-v3-*.json text eol=lf
/validation/omega-nnue-king-state-v4-*.json text eol=lf
/validation/omega-nnue-king-state-v5-*.json text eol=lf
/src/omega_nnue.cpp text eol=lf
/src/omega_nnue.hpp text eol=lf
/tests/omega_nnue.cpp text eol=lf
/tests/omega_nnue_arch4_parity.py text eol=lf
/test-msvc.ps1 text eol=lf

# The frozen runtime is an opaque byte archive, including text sidecars.
/tools/omega_nnue/frozen_runtime/king-state-v3/** -text -diff !eol
/tools/omega_nnue/frozen_runtime/king-state-v4/** -text -diff !eol
/tools/omega_nnue/frozen_runtime/king-state-v5/** -text -diff !eol
